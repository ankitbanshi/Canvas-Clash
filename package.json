{
  "name": "canvas-clash",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run start --workspace=client\" --names \"backend,client\" --prefix-colors \"cyan,magenta\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:client": "npm run start --workspace=client",
    "start": "npm run start --workspace=backend",
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build:backend": "npm run build --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "@hackernoon/pixel-icon-library": "^1.1.0"
  }
}
